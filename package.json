{
  "name": "@dano/dano",
  "version": "0.2.18",
  "private": true,
  "description": "Dano P0 web LLM chat",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -C apps/dano build",
    "build:site": "pnpm -C apps/sites build",
    "container:build": "podman build -t dano-app:local .",
    "container:down": "node scripts/local-container.mjs down",
    "container:up": "node scripts/local-container.mjs up",
    "build:server": "pnpm -C apps/dano build:server",
    "build:web": "pnpm -C apps/dano build:web",
    "check": "pnpm -C apps/dano check",
    "check:server": "pnpm -C apps/dano check:server",
    "check:type": "pnpm run check:server",
    "check:web": "pnpm -C apps/dano check:web",
    "deploy:down": "node scripts/deploy-compose.mjs down",
    "deploy:logs": "node scripts/deploy-compose.mjs logs",
    "deploy:ps": "node scripts/deploy-compose.mjs ps",
    "deploy:release": "node scripts/deploy-release.mjs",
    "deploy:stop": "node scripts/deploy-compose.mjs stop",
    "deploy:up": "node scripts/deploy-compose.mjs up",
    "deploy:check-bash": "node scripts/check-bash-acceptance.mjs",
    "deploy:check-bash:container": "sh scripts/check-bash-acceptance-container.sh",
    "deploy:check-exposure": "node scripts/check-deploy-exposure.mjs",
    "dev:server": "pnpm -C apps/dano dev:server",
    "dev:web": "pnpm -C apps/dano dev:web",
    "secret:set": "node scripts/set-env-secret.mjs",
    "smoke:deploy": "node scripts/smoke-dano-deploy.mjs",
    "start": "pnpm -C apps/dano start",
    "test": "vitest run",
    "test:auth-built-entrypoint": "pnpm run build:server && node scripts/check-production-auth-entrypoint.mjs",
    "test:auth-real-provider-skill": "node scripts/check-provider-skill-release-gate.mjs",
    "test:auth-real-refresh:run": "pnpm -C apps/dano exec node --import jiti/register ../../scripts/run-real-refresh-acceptance.ts",
    "test:auth-real-users": "node scripts/check-real-user-isolation.mjs",
    "test:auth-release": "DANO_NGINX_RUNTIME_TEST=1 vitest run apps/dano/src/__tests__/main.test.ts apps/dano/src/__tests__/oauth-login-http.test.ts apps/dano/src/__tests__/anonymous-user-http.test.ts apps/dano/src/__tests__/user-runtime-isolation-http.test.ts apps/dano/src/bridge/__tests__/credential-broker.test.ts apps/dano/src/bridge/__tests__/anonymous-user-cleanup.test.ts apps/dano/src/bridge/__tests__/detached-session.test.ts apps/dano/src/bridge/__tests__/heimdall-extension.test.ts apps/dano/web/src/layout/AppHeader.test.ts apps/dano/web/src/components/ReauthenticationDialog.test.ts apps/dano/web/src/composables/bridgeStore.prompt.test.ts apps/dano/src/bridge/__tests__/production-auth-deploy.test.ts && vitest run apps/dano/src/bridge/__tests__/deploy-compose.test.ts -t \"builds releases|stops a release|removes only fixed Demo\" && pnpm run test:auth-built-entrypoint && vitest run apps/dano/src/bridge/__tests__/bridge-rpc-adapter.test.ts -t \"projects provider_request results as JSON-safe transcript data\"",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.8.0",
    "happy-dom": "^20.10.6",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.8",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "apps/*"
  ]
}
