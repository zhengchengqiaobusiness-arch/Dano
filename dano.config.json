  "openVikingSettings": {
    "enabled": false,
    "baseUrl": "http://openviking:1933",
    "requestTimeoutMs": 45000,
    "maxContentBytes": 65536,
    "policyVersion": "memory-v1",
    "policy": {
      "maxPayloadBytes": 10240,
      "recallTimeoutMs": 10000,
      "recallTokenBudget": 15000,
      "recallLimit": 10,
      "minimumScore": 0.5
