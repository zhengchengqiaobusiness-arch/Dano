        "maxWaitMs": 5000,
        "workTimeoutMs": 50000,
        "leaseMs": 110000,
        "initialBackoffMs": 1000,
        "maxBackoffMs": 5000,
        "maxAttempts": 3,
        "maxRequestsPerBatch": 10
      }
