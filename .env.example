# Direct OpenAI Responses API used for capability refinement and planning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Optional: OpenAI-compatible endpoint.
OPENAI_BASE_URL=

# Pi web assistant. PI_BASE_URL may point to any OpenAI-compatible service.
PI_BASE_URL=
PI_API_KEY=
PI_MODEL=
# Leave blank to use the Studio's OpenAI-compatible provider registration.
PI_PROVIDER=

# Browser recorder
BSS_HEADLESS=false
BSS_PROFILE_DIR=.business-skill-studio/browser-profile
BSS_MAX_RESPONSE_BYTES=262144

# Exported Skill runtime auth. NEVER hard-code production credentials in contracts.
# Example:
# SKILL_AUTH_HEADERS={"Authorization":"Bearer ...","X-Tenant-Id":"..."}
SKILL_AUTH_HEADERS={}
