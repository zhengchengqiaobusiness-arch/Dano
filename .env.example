DANO_HOST=0.0.0.0
DANO_PORT=8080
DANO_NGINX_PORT=18082
DANO_HTTPS_PORT=18443
DANO_EXPOSURE_MODE=http
DANO_DEFAULT_WORKSPACE_PATH=/tmp/dano
DANO_RUNTIME_DIR=/opt/dano/runtime-data
DANO_DEPLOY_DIR=/opt/dano/deploy
# Release Build writes DANO_NGINX_CONF and DANO_NGINX_SHARED_DIR into its
# Deploy Control Directory. Source-checkout runs select repository assets.
DANO_SECRETS_DIR=/opt/dano/deploy/.secrets
# Optional deployment override for productName in dano.config.json.
# DANO_PRODUCT_NAME=
# Anonymous User data expires after 24 hours idle and is scanned hourly.
# Values are positive integer milliseconds; invalid values stop startup.
# DANO_ANONYMOUS_IDLE_TTL_MS=86400000
# DANO_ANONYMOUS_CLEANUP_INTERVAL_MS=3600000
# DANO_LOGIN_SESSION_IDLE_TTL_MS=28800000
# DANO_LOGIN_SESSION_ABSOLUTE_TTL_MS=604800000
# DANO_LOGIN_SESSION_CLEANUP_INTERVAL_MS=3600000

# Optional open-websearch daemon configuration. The daemon remains bound to the
# app container loopback interface and is not published by Compose.
OPEN_WEBSEARCH_DEFAULT_SEARCH_ENGINE=duckduckgo
OPEN_WEBSEARCH_SEARCH_MODE=auto
# OPEN_WEBSEARCH_ALLOWED_SEARCH_ENGINES=duckduckgo,bing,baidu
# OPEN_WEBSEARCH_USE_PROXY=true
# OPEN_WEBSEARCH_PROXY_URL=http://host.containers.internal:7890
# OPEN_WEBSEARCH_FAKE_IP_CIDRS=198.18.0.0/15
# OPEN_WEBSEARCH_FETCH_WEB_INSECURE_TLS=false

# Production requires one OAuth confidential client. Server-to-server endpoints,
# callback, and API origin must use trusted HTTPS. Keep client and encryption
# secrets only in the Deploy Control Directory; never commit their values or
# bake them into an image.
# DANO_OAUTH_ISSUER=
# DANO_OAUTH_AUTHORIZATION_ENDPOINT=
# Explicitly allow only the browser-facing authorization endpoint to use HTTP.
# DANO_OAUTH_ALLOW_INSECURE_AUTHORIZATION_ENDPOINT=false
# Explicitly allow issuer, token, identity, revocation, and API endpoints to use
# HTTP when the deployment owner has accepted plaintext server-to-provider
# transport. This does not add a proxy, relay, or alternate network path.
# DANO_OAUTH_ALLOW_INSECURE_SERVER_ENDPOINTS=false
# DANO_OAUTH_TOKEN_ENDPOINT=
# DANO_OAUTH_IDENTITY_ENDPOINT=
# OA business API origin: use the OA page origin, not the token endpoint origin.
# DANO_OAUTH_API_ORIGIN=
# DANO_OAUTH_CLIENT_ID=
# DANO_OAUTH_CLIENT_SECRET=
# Defaults to client_secret_post. Use client_secret_basic when the provider
# requires HTTP Basic authentication at the token endpoint.
# DANO_OAUTH_CLIENT_AUTH_METHOD=client_secret_post
# DANO_OAUTH_SCOPE=
# Optional static transport headers required by the configured provider, as JSON.
# DANO_OAUTH_PROVIDER_HEADERS_JSON=
# Set only when the provider requires callback state again during code exchange.
# DANO_OAUTH_SEND_STATE_TO_TOKEN_ENDPOINT=false
# Optional provider credential revocation. RFC 7009 requires an explicit
# endpoint; delete-query-basic defaults to the token endpoint.
# DANO_OAUTH_REVOCATION_TRANSPORT=delete-query-basic
# DANO_OAUTH_REVOCATION_ENDPOINT=
# DANO_OAUTH_REDIRECT_URI=
# Release Build initializes and preserves this Dano-owned pair in the Deploy
# Control Directory. Manual Compose deployments must provide both values.
# The key is 32 random bytes encoded as base64url.
# DANO_OAUTH_CREDENTIAL_KEY=
# DANO_OAUTH_CREDENTIAL_KEY_VERSION=
# Production compose starts a prebuilt image with --no-build.
DANO_IMAGE=dano-app:local

# Production release builds in /tmp/dano-build-* and copies deploy inputs here.
# DANO_REPO_URL=git@github.com:zhengchengqiaobusiness-arch/Dano.git
# DANO_GIT_REF=main

# Required only for https, both, and both-no-redirect-http exposure modes.
# DANO_TLS_CERT_PATH=/absolute/path/to/certificate.pem
# DANO_TLS_KEY_PATH=/absolute/path/to/private-key.pem

# Configure model provider credentials on the server only.
# XIAOMI_TOKEN_PLAN_CN_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
