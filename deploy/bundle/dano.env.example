# Copy to dano.env and restrict it to the deploying administrator (chmod 600).
# Use literal Compose dotenv values. Single-quote credentials containing $ or #.
DANO_HTTPS_PORT=443
DANO_TLS_CERT_PATH=/absolute/path/to/fullchain.pem
DANO_TLS_KEY_PATH=/absolute/path/to/privkey.pem
DANO_OAUTH_ISSUER=
DANO_OAUTH_AUTHORIZATION_ENDPOINT=
DANO_OAUTH_TOKEN_ENDPOINT=
DANO_OAUTH_IDENTITY_ENDPOINT=
DANO_OAUTH_API_ORIGIN=
DANO_OAUTH_CLIENT_ID=
DANO_OAUTH_CLIENT_SECRET=
DANO_OAUTH_SCOPE=
DANO_OAUTH_REDIRECT_URI=https://dano.example.invalid/api/auth/callback
# Set the key for the model provider you use, or use its supported *_API_KEY_FILE
# variable with a path under /run/secrets.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DANO_PRODUCT_NAME=
