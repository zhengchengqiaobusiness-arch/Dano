      "processStatus": {"type": "enum", "options": [{"label": "未提交", "value": 0}, {"label": "审批中", "value": 1}, {"label": "审批通过", "value": 2}, {"label": "审批不通过", "value": 3}, {"label": "已取消", "value": 4}]},
